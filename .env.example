# Studia backend configuration. Copy to .env at the repo root or to backend/.env.
# DATABASE_URL is required and must be a postgresql:// URL. The app raises
# RuntimeError at import otherwise. Every other variable is optional; the
# values below match the defaults in backend/config.py.

# Ollama (local LLM). Use qwen3 for general coaching; qwen3-coder if you focus on live coding practice.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
# HTTP timeout in seconds for Ollama chat, streaming, and history summarisation.
OLLAMA_TIMEOUT=300

# Agent
AGENT_MODE=true
MAX_AGENT_TURNS=5

# Session and history
LOG_SESSIONS=true
MAX_HISTORY_EXCHANGES=30

# Research (company/JD)
RESEARCH_MAX_SOURCES=8
RESEARCH_CACHE_DAYS=7

# Loaded by config.py. start.sh and the Docker image do not read these;
# they bind 127.0.0.1:8000 and 0.0.0.0:8000 respectively.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database (required). PostgreSQL only.
DATABASE_URL=postgresql://user:password@localhost:5432/studia
